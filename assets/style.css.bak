/* ==========================================================================
   ZothPen — CRT field manual
   Layer cake (see crt-terminal-effects): base panel -> scanlines -> grille+vignette.
   Effect budget: 3 layers. Everything else is typography and layout.
   ========================================================================== */

/* ---------- tokens ---------- */
:root{
  --bg:      #050805;
  --bg-1:    #07100a;
  --bg-2:    #0a1710;
  --phos:    #33ff66;
  --phos-dim: color-mix(in srgb, var(--phos) 62%, transparent);
  --phos-faint: color-mix(in srgb, var(--phos) 26%, transparent);
  --line:    color-mix(in srgb, var(--phos) 22%, transparent);
  --line-hi: color-mix(in srgb, var(--phos) 45%, transparent);
  --amber:   #ffb000;
  --red:     #ff4d4d;
  --cyan:    #4fd6ff;
  --violet:  #c08bff;
  --ink:     var(--phos);
  --ink-dim: var(--phos-dim);
  --mono: ui-monospace, "JetBrains Mono", "DejaVu Sans Mono", "Cascadia Mono", "SFMono-Regular", Menlo, Consolas, monospace;
  --fs: 14px;
  --lh: 1.45;
  --pad: 14px;
  --r: 2px;
  --scan-op: .26;
  --glow: 0 0 2px currentColor, 0 0 9px color-mix(in srgb, currentColor 38%, transparent);
}

html[data-phosphor="amber"]{
  --bg:#0a0600; --bg-1:#120c02; --bg-2:#1a1204;
  --phos:#ffb000; --amber:#ff8a3d; --cyan:#ffd98a; --violet:#ffc266;
}
html[data-phosphor="ice"]{
  --bg:#04070a; --bg-1:#070d12; --bg-2:#0b131a;
  --phos:#d8f4ff; --amber:#8fe3ff; --cyan:#7cc7ff; --violet:#a9c4ff;
}
html[data-phosphor="magenta"]{
  --bg:#0a0408; --bg-1:#120711; --bg-2:#1a0a17;
  --phos:#ff5ecb; --amber:#ffb000; --cyan:#7ad9ff; --violet:#c08bff;
}
html[data-scan="off"]{ --scan-op: 0; }
html[data-motion="off"] .blink,html[data-motion="off"] .flick{ animation:none !important; }
html[data-bloom="off"] *{ text-shadow:none !important; }
html:not([data-bloom="on"]) .brand-name{ text-shadow:none; }

@media (prefers-reduced-motion: reduce){
  *{ animation:none !important; transition:none !important; }
}

*{ box-sizing:border-box; }
html,body{ height:100%; }
body{
  margin:0; background:var(--bg); color:var(--ink);
  font: var(--fs)/var(--lh) var(--mono);
  text-shadow: var(--glow);
  -webkit-font-smoothing: antialiased;
  overflow:hidden;
}
html[data-bloom="off"] body{ text-shadow:none; }

::selection{ background: color-mix(in srgb, var(--phos) 35%, transparent); color:#fff; }
*{ scrollbar-width: thin; scrollbar-color: var(--line-hi) transparent; }
*::-webkit-scrollbar{ width:10px; height:10px; }
*::-webkit-scrollbar-thumb{ background:var(--line); border:2px solid transparent; background-clip:content-box; }
*::-webkit-scrollbar-thumb:hover{ background:var(--line-hi); background-clip:content-box; }
*::-webkit-scrollbar-track{ background:transparent; }

/* ---------- crt layers ---------- */
.crt-frame{ position:fixed; inset:0; pointer-events:none; z-index:9000; }
.crt-frame::after{
  content:''; position:absolute; inset:0; opacity:var(--scan-op);
  background: repeating-linear-gradient(to bottom, rgba(0,0,0,.30) 0 1px, transparent 1px 2px);
  mix-blend-mode:multiply;
}
.crt-frame::before{
  content:''; position:absolute; inset:0;
  background:
    radial-gradient(125% 105% at 50% 50%, transparent 58%, rgba(0,0,0,.5) 100%),
    repeating-linear-gradient(to right, rgba(255,0,0,.035) 0 1px, rgba(0,255,0,.035) 1px 2px, rgba(0,0,255,.035) 2px 3px);
}

.flick{ animation: flick 4.5s steps(2,end) infinite; }
@keyframes flick{ 0%,96%{opacity:1} 97%{opacity:.94} 98%{opacity:1} 99%{opacity:.97} }
.blink{ animation: blink 1.05s steps(2,start) infinite; }
@keyframes blink{ to{ visibility:hidden } }

/* ---------- boot ---------- */
.boot{
  position:fixed; inset:0; z-index:8000; background:#000;
  padding:clamp(14px,4vw,42px); overflow:hidden;
}
.boot[hidden]{ display:none; }
.boottext{
  margin:0; font: var(--fs)/1.35 var(--mono); color:var(--phos);
  text-shadow:var(--glow); white-space:pre-wrap; word-break:break-word;
}
.bootskip{
  position:absolute; right:18px; bottom:16px; background:none; border:0; color:var(--phos-dim);
  font:inherit; cursor:pointer; text-shadow:inherit;
}
.bootskip:hover{ color:var(--phos); }

/* ---------- app shell ---------- */
.app{ height:100vh; display:grid; grid-template-rows:auto 1fr auto; }

.topbar{
  display:flex; align-items:center; gap:18px;
  padding: 9px var(--pad); border-bottom:1px solid var(--line-hi);
  background: linear-gradient(var(--bg-1), var(--bg));
}
.brand{ display:flex; align-items:baseline; gap:9px; white-space:nowrap; }
.brand-mark{ color:var(--amber); font-size:1.15em; }
.brand-name{ font-weight:700; letter-spacing:.12em; font-size:1.05em; }
.brand-name b{ color:var(--amber); }
.brand-sub{ color:var(--phos-dim); font-size:.82em; letter-spacing:.02em; }
.topbar-mid{ flex:1; display:flex; justify-content:center; min-width:0; }
.xp{ display:flex; align-items:center; gap:9px; min-width:0; }
.xp-label{ color:var(--phos-dim); font-size:.82em; white-space:nowrap; }
.xp-track{
  display:inline-block; width:min(30ch,26vw); height:.85em; border:1px solid var(--line);
  position:relative; overflow:hidden;
}
.xp-fill{ display:block; height:100%; width:0%;
  background: repeating-linear-gradient(90deg, var(--phos) 0 3px, transparent 3px 4px);
  transition: width .45s ease; }
.xp-val{ color:var(--phos-dim); font-size:.78em; }
.topbar-right{ display:flex; align-items:center; gap:8px; }

.chip{
  border:1px solid var(--line); padding:2px 8px; color:var(--phos-dim);
  font-size:.78em; white-space:nowrap;
}
.btn{
  background:transparent; color:var(--ink); border:1px solid var(--line-hi);
  font:inherit; font-size:.84em; padding:4px 10px; cursor:pointer; border-radius:var(--r);
  text-shadow:inherit;
}
.btn:hover,.btn:focus-visible{ background: color-mix(in srgb, var(--phos) 14%, transparent); outline:none; }
.btn:active{ background: color-mix(in srgb, var(--phos) 26%, transparent); }
.btn.danger{ border-color: color-mix(in srgb, var(--red) 60%, transparent); color:var(--red); }
.btn.danger:hover{ background: color-mix(in srgb, var(--red) 16%, transparent); }
.btn.x{ padding:1px 7px; }
.btn.primary{ border-color:var(--phos); color:#031004; background:var(--phos); font-weight:700; }
.btn.primary:hover{ background:color-mix(in srgb, var(--phos) 80%, #fff); }

.shell{
  display:grid; grid-template-columns: 27ch minmax(0,1fr) 30ch;
  min-height:0; overflow:hidden;
}

/* ---------- sidebar ---------- */
.sidebar{
  border-right:1px solid var(--line-hi); overflow:auto; padding:10px 0 40px;
  background: linear-gradient(90deg, var(--bg-1), transparent);
}
.navgroup{ padding: 8px 12px 4px; color:var(--amber); font-size:.76em; letter-spacing:.14em; }
.navitem{
  display:flex; align-items:center; gap:8px; width:100%; text-align:left;
  background:none; border:0; border-left:2px solid transparent; color:var(--ink);
  font:inherit; font-size:.88em; padding:5px 12px; cursor:pointer; text-shadow:inherit;
}
.navitem:hover{ background: color-mix(in srgb, var(--phos) 10%, transparent); }
.navitem.on{ border-left-color:var(--phos); background: color-mix(in srgb, var(--phos) 14%, transparent); font-weight:700; }
.navitem .ico{ color:var(--phos-dim); width:2ch; display:inline-block; }
.navitem .cnt{ margin-left:auto; color:var(--phos-dim); font-size:.85em; }
.moditem{ align-items:flex-start; gap:7px; padding-top:6px; padding-bottom:6px; flex-direction:column; }
.moditem .modrow{ display:flex; gap:8px; width:100%; align-items:baseline; }
.moditem .bar{ color:var(--phos-dim); letter-spacing:-.04em; font-size:.86em; }
.moditem.done .bar{ color:var(--phos); }
.sidebar-sub{ color:var(--phos-dim); font-size:.78em; padding:0 12px 6px; }

/* ---------- main / view ---------- */
.main{ overflow:auto; padding:20px clamp(14px,2.4vw,30px) 70px; min-width:0; scroll-behavior:smooth; }
.h1{ font-size:1.5em; margin:0 0 2px; letter-spacing:.02em; font-weight:700; }
.h2{ font-size:1.08em; margin:26px 0 8px; letter-spacing:.06em; color:var(--amber); }
.h3{ font-size:.95em; margin:18px 0 6px; color:var(--phos); letter-spacing:.04em; }
.sub{ color:var(--phos-dim); margin:0 0 4px; }
.muted{ color:var(--phos-dim); }
.dim{ opacity:.62; }
.small{ font-size:.85em; }
.mono{ font-family:var(--mono); }
p{ margin:.5em 0; }
ul,ol{ margin:.45em 0 .7em; padding-left:1.4em; }
li{ margin:.22em 0; }
li::marker{ color:var(--phos-dim); }
a{ color:var(--cyan); text-decoration:none; border-bottom:1px dotted color-mix(in srgb,var(--cyan) 55%, transparent); }
a:hover{ border-bottom-style:solid; }
hr{ border:0; border-top:1px dashed var(--line); margin:20px 0; }
b,strong{ font-weight:700; }
code, kbd{ font-family:var(--mono); }
:not(pre)>code{
  background: color-mix(in srgb, var(--phos) 11%, transparent);
  border:1px solid var(--line); padding:0 4px; border-radius:var(--r); white-space:nowrap;
}
kbd{ border:1px solid var(--line-hi); padding:0 4px; font-size:.85em; }

/* box-drawn rule */
.rule{ color:var(--phos-dim); overflow:hidden; white-space:nowrap; font-size:.8em; margin:16px 0 10px; letter-spacing:.02em; }
.rule > b{ color:var(--amber); font-weight:700; }

/* breadcrumb */
.crumbs{ color:var(--phos-dim); font-size:.8em; margin-bottom:12px; letter-spacing:.04em; }
.crumbs b{ color:var(--phos); }

/* ---------- panels & cards ---------- */
.grid{ display:grid; gap:12px; }
.grid.g2{ grid-template-columns: repeat(auto-fit, minmax(30ch,1fr)); }
.grid.g3{ grid-template-columns: repeat(auto-fit, minmax(22ch,1fr)); }
.panel{ border:1px solid var(--line); background: color-mix(in srgb, var(--bg-1) 70%, transparent); padding:12px 14px; border-radius:var(--r); }
.panel.hi{ border-color:var(--line-hi); }
.card{
  border:1px solid var(--line); background: color-mix(in srgb, var(--bg-1) 60%, transparent);
  padding:11px 13px; cursor:pointer; text-align:left; font:inherit; color:inherit;
  text-shadow:inherit; border-radius:var(--r); display:block; width:100%;
}
.card:hover,.card:focus-visible{ border-color:var(--phos); background: color-mix(in srgb, var(--phos) 9%, transparent); outline:none; }
.card .t{ display:flex; gap:8px; align-items:baseline; }
.card .t b{ font-weight:700; }
.card .d{ color:var(--phos-dim); font-size:.85em; margin-top:3px; }
.card .tags{ margin-top:6px; display:flex; gap:5px; flex-wrap:wrap; }
.tag{
  border:1px solid var(--line); color:var(--phos-dim); font-size:.72em; padding:0 5px; letter-spacing:.05em;
}
.tag.hard{ border-color: color-mix(in srgb,var(--red) 55%, transparent); color:var(--red); }
.tag.med{ border-color: color-mix(in srgb,var(--amber) 55%, transparent); color:var(--amber); }
.tag.easy{ border-color: color-mix(in srgb,var(--cyan) 55%, transparent); color:var(--cyan); }
.tag.os{ border-color: var(--line-hi); }

/* stat strip */
.stats{ display:flex; flex-wrap:wrap; gap:0; border:1px solid var(--line); }
.stat{ padding:8px 14px; border-right:1px dashed var(--line); min-width:9ch; }
.stat:last-child{ border-right:0; }
.stat .k{ color:var(--phos-dim); font-size:.74em; letter-spacing:.1em; }
.stat .v{ font-size:1.25em; font-weight:700; }
.stat .v.amber{ color:var(--amber); }

/* progress bar as characters */
.pbar{ letter-spacing:-.02em; white-space:pre; }

/* ---------- terminal ---------- */
.term{
  border:1px solid var(--line-hi); background:#020402; border-radius:var(--r);
  overflow:hidden; margin:14px 0;
}
.term-head{
  display:flex; align-items:center; gap:10px; padding:5px 10px;
  border-bottom:1px solid var(--line); background: color-mix(in srgb, var(--phos) 7%, transparent);
  font-size:.8em; color:var(--phos-dim);
}
.term-head .dot{ color:var(--amber); }
.term-body{
  padding:10px 12px; max-height:min(52vh,460px); overflow:auto; white-space:pre-wrap;
  word-break:break-word; font: inherit; line-height:1.42; background:transparent;
}
.term-body .ln{ display:block; }
.term-in{ display:flex; align-items:center; gap:8px; border-top:1px solid var(--line); padding:6px 10px; background:#010301; }
.term-in .ps1{ color:var(--amber); white-space:nowrap; font-size:.85em; }
.term-in input{
  flex:1; min-width:0; background:transparent; border:0; color:var(--ink);
  font:inherit; outline:none; text-shadow:inherit;
}
.term-in input::placeholder{ color: color-mix(in srgb, var(--phos) 30%, transparent); }
.o-ok{ color:var(--phos); }
.o-warn{ color:var(--amber); }
.o-err{ color:var(--red); }
.o-info{ color:var(--cyan); }
.o-dim{ color:var(--phos-dim); }
.o-hl{ color:var(--violet); }

/* ---------- code blocks ---------- */
.code{
  border:1px solid var(--line); background:#020402; border-radius:var(--r);
  margin:8px 0; overflow:hidden;
}
.code-head{
  display:flex; align-items:center; gap:8px; padding:3px 8px; font-size:.75em;
  color:var(--phos-dim); border-bottom:1px solid var(--line);
}
.code-head .sp{ flex:1; }
.code-body{ padding:8px 10px; overflow:auto; white-space:pre; font-size:.92em; }
.copy{
  background:transparent; border:1px solid var(--line); color:var(--phos-dim);
  font:inherit; font-size:.9em; cursor:pointer; padding:0 6px; text-shadow:inherit; border-radius:var(--r);
}
.copy:hover{ color:var(--phos); border-color:var(--phos); }
.cmd{ color:var(--ink); }
.c-flag{ color:var(--cyan); }
.c-str{ color:var(--amber); }
.c-num{ color:var(--violet); }
.c-com{ color: color-mix(in srgb, var(--phos) 45%, transparent); font-style:italic; }
.c-kw{ color:var(--violet); font-weight:700; }
.c-var{ color:var(--amber); }
.c-err{ color:var(--red); }

/* ---------- tables ---------- */
table{ border-collapse:collapse; width:100%; margin:10px 0; font-size:.9em; }
th,td{ text-align:left; padding:5px 9px; border-bottom:1px solid var(--line); vertical-align:top; }
th{ color:var(--amber); font-weight:700; letter-spacing:.05em; font-size:.86em; text-transform:uppercase; }
tbody tr:hover{ background: color-mix(in srgb, var(--phos) 6%, transparent); }
td.fl{ color:var(--cyan); white-space:nowrap; width:22ch; }
td.k{ color:var(--amber); white-space:nowrap; }

/* ---------- callouts ---------- */
.note{ border:1px solid var(--line); border-left:3px solid var(--line-hi); padding:9px 12px; margin:10px 0; background: color-mix(in srgb, var(--bg-2) 60%, transparent); }
.note .lab{ font-size:.76em; letter-spacing:.12em; color:var(--amber); display:block; margin-bottom:3px; }
.note.danger{ border-left-color:var(--red); } .note.danger .lab{ color:var(--red); }
.note.ok{ border-left-color:var(--phos); }
.note.info{ border-left-color:var(--cyan); } .note.info .lab{ color:var(--cyan); }

/* ---------- tabs ---------- */
.tabs{ display:flex; gap:0; border-bottom:1px solid var(--line-hi); margin:14px 0 14px; flex-wrap:wrap; }
.tab{
  background:none; border:0; border-bottom:2px solid transparent; color:var(--phos-dim);
  font:inherit; font-size:.86em; padding:6px 13px; cursor:pointer; text-shadow:inherit;
}
.tab:hover{ color:var(--phos); }
.tab.on{ color:var(--phos); border-bottom-color:var(--phos); font-weight:700; }

/* ---------- steps ---------- */
.step{ display:flex; gap:11px; padding:10px 0; border-bottom:1px dashed var(--line); }
.step:last-child{ border-bottom:0; }
.step .mark{ color:var(--phos-dim); white-space:pre; font-size:.9em; }
.step.done .mark{ color:var(--phos); }
.step .body{ flex:1; min-width:0; }
.step .body .why{ color:var(--phos-dim); font-size:.88em; margin-top:4px; }
.step .n{ color:var(--amber); font-size:.8em; letter-spacing:.08em; }

/* ---------- quiz ---------- */
.qwrap{ max-width: 78ch; }
.q{ font-size:1.02em; margin:0 0 10px; }
.qnum{ color:var(--amber); font-size:.8em; letter-spacing:.1em; }
.opt{
  display:block; width:100%; text-align:left; border:1px solid var(--line); background:transparent;
  color:inherit; font:inherit; text-shadow:inherit; padding:8px 11px; margin:6px 0; cursor:pointer; border-radius:var(--r);
}
.opt:hover:not(.locked){ border-color:var(--phos); background: color-mix(in srgb, var(--phos) 8%, transparent); }
.opt .k{ color:var(--amber); margin-right:8px; }
.opt.right{ border-color:var(--phos); background: color-mix(in srgb, var(--phos) 16%, transparent); }
.opt.wrong{ border-color:var(--red); background: color-mix(in srgb, var(--red) 14%, transparent); }
.opt.locked{ cursor:default; }
.expl{ border-top:1px dashed var(--line); margin-top:10px; padding-top:8px; color:var(--phos-dim); font-size:.9em; }

/* ---------- forms ---------- */
label.f{ display:block; margin:10px 0; font-size:.86em; color:var(--phos-dim); }
label.f > span{ display:block; margin-bottom:3px; letter-spacing:.06em; }
input[type=text],input[type=number],select,textarea{
  background:#020402; border:1px solid var(--line); color:var(--ink); font:inherit;
  padding:5px 8px; width:100%; border-radius:var(--r); text-shadow:inherit; outline:none;
}
input:focus,select:focus,textarea:focus{ border-color:var(--phos); }
input[type=range]{ width:100%; accent-color:var(--phos); }
input[type=checkbox]{ accent-color:var(--phos); }
textarea{ min-height:14em; resize:vertical; white-space:pre; font-size:.9em; }

/* ---------- rail ---------- */
.rail{
  border-left:1px solid var(--line-hi); overflow:auto; padding:12px 12px 40px;
  background: linear-gradient(270deg, var(--bg-1), transparent); font-size:.88em;
}
.rail h4{ margin:0 0 6px; font-size:.76em; letter-spacing:.14em; color:var(--amber); font-weight:700; }
.rail .blk{ margin-bottom:16px; }
.rail .kv{ display:flex; gap:6px; justify-content:space-between; border-bottom:1px dotted var(--line); padding:3px 0; }
.rail .kv span:first-child{ color:var(--phos-dim); }
.rail .kv span:last-child{ text-align:right; }
.badge{ border:1px solid var(--line); padding:3px 7px; font-size:.78em; margin:3px 3px 0 0; display:inline-block; color:var(--phos-dim); }
.badge.on{ border-color:var(--phos); color:var(--phos); }
.next{ border:1px solid var(--line-hi); padding:9px 10px; }
.next b{ display:block; margin-bottom:3px; }

/* ---------- statusbar ---------- */
.statusbar{
  display:flex; align-items:center; gap:14px; padding:4px 12px; border-top:1px solid var(--line-hi);
  background: linear-gradient(var(--bg), var(--bg-1)); font-size:.78em; color:var(--phos-dim);
  overflow:hidden;
}
.statuskeys{ display:flex; gap:12px; white-space:nowrap; overflow:hidden; flex:1; }
.statuskeys b{ color:var(--phos); }
.statusmsg{ white-space:nowrap; color:var(--amber); }

/* ---------- overlay / palette ---------- */
.overlay{
  position:fixed; inset:0; z-index:7000; background: rgba(0,0,0,.72);
  display:flex; align-items:flex-start; justify-content:center; padding: min(12vh,120px) 16px 16px;
}
.overlay[hidden]{ display:none; }
.palette,.tweaks{
  width:min(76ch,100%); border:1px solid var(--phos); background:var(--bg-1);
  box-shadow: 0 0 0 1px color-mix(in srgb,var(--phos) 20%,transparent), 0 24px 60px rgba(0,0,0,.7);
  border-radius:var(--r); max-height:76vh; display:flex; flex-direction:column;
}
.palette-head{ display:flex; align-items:center; gap:8px; padding:9px 12px; border-bottom:1px solid var(--line-hi); }
.prompt-char{ color:var(--amber); }
.palette-head input{ border:0; background:transparent; font-size:1.02em; padding:2px 0; }
.palette-head input:focus{ border:0; }
.palette-list{ list-style:none; margin:0; padding:6px 0; overflow:auto; flex:1; }
.palette-list li{ padding:5px 13px; display:flex; gap:10px; align-items:baseline; cursor:pointer; margin:0; }
.palette-list li .k{ color:var(--phos-dim); font-size:.78em; letter-spacing:.08em; min-width:9ch; }
.palette-list li .t{ flex:1; min-width:0; }
.palette-list li .d{ color:var(--phos-dim); font-size:.8em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:34ch; }
.palette-list li.on{ background: color-mix(in srgb, var(--phos) 16%, transparent); }
.palette-list li.on .t{ font-weight:700; }
.palette-foot{ display:flex; gap:16px; padding:5px 12px; border-top:1px solid var(--line); color:var(--phos-dim); font-size:.76em; }
.tweaks-head{ display:flex; justify-content:space-between; align-items:center; padding:8px 12px; border-bottom:1px solid var(--line-hi); color:var(--amber); letter-spacing:.12em; font-size:.8em; }
.tweaks-body{ padding:12px 14px; overflow:auto; }
.tweak-row{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin:9px 0; font-size:.88em; color:var(--phos-dim); }
.tweak-row input[type=text],.tweak-row select{ width:auto; min-width:20ch; }
.tweak-note{ color:var(--phos-dim); font-size:.8em; border-top:1px dashed var(--line); padding-top:10px; margin-top:12px; }
.tweak-actions{ display:flex; gap:8px; margin-top:12px; flex-wrap:wrap; }

/* ---------- toasts ---------- */
.toasts{ position:fixed; right:14px; bottom:34px; z-index:9500; display:flex; flex-direction:column; gap:7px; align-items:flex-end; }
.toast{
  border:1px solid var(--phos); background:var(--bg-1); padding:6px 12px; font-size:.84em;
  animation: toastin .18s ease; max-width:44ch;
}
.toast.warn{ border-color:var(--amber); }
.toast.err{ border-color:var(--red); }
@keyframes toastin{ from{ transform:translateY(8px); opacity:0 } }

/* ---------- responsive ---------- */
.menubtn{ display:none; }
@media (max-width: 1180px){
  .shell{ grid-template-columns: 24ch minmax(0,1fr); }
  .rail{ display:none; }
  .rail.open{
    display:block; position:fixed; right:0; top:0; bottom:0; width:min(30ch,86vw);
    z-index:6000; background:var(--bg-1); box-shadow:-14px 0 40px rgba(0,0,0,.7);
  }
}
@media (max-width: 820px){
  .shell{ grid-template-columns: minmax(0,1fr); }
  .sidebar{ display:none; }
  .sidebar.open{
    display:block; position:fixed; left:0; top:0; bottom:0; width:min(28ch,88vw);
    z-index:6000; background:var(--bg-1); box-shadow:14px 0 40px rgba(0,0,0,.7);
  }
  .menubtn{ display:inline-block; }
  .brand-sub{ display:none; }
  .xp-track{ width:16vw; }
  .main{ padding:14px 12px 80px; }
}
